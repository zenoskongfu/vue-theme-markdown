{
  "name": "vue-theme-markdown",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.2",
  "publisher": "zenoschen",
  "author": "zenoschen",
  "icon": "images/icon.png",
  "license": "MIT",
  "homepage": "https://github.com/zenoskongfu/vue-theme-markdown#readme",
  "bugs": {
    "url": "https://github.com/zenoskongfu/vue-theme-markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zenoskongfu/vue-theme-markdown.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "markdown",
    "preview",
    "theme",
    "novel",
    "reading",
    "小说",
    "vue"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "galleryBanner": {
    "color": "#20382c",
    "theme": "dark"
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./v-green.css"
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "vueGreenMarkdown.fontSize": {
          "type": "integer",
          "default": 14,
          "minimum": 10,
          "maximum": 32,
          "scope": "resource",
          "description": "%config.fontSize%"
        },
        "vueGreenMarkdown.tableRowHeight": {
          "type": "integer",
          "default": 36,
          "minimum": 24,
          "maximum": 120,
          "scope": "resource",
          "description": "%config.tableRowHeight%"
        },
        "vueGreenMarkdown.horizontalMargin": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 320,
          "scope": "resource",
          "description": "%config.horizontalMargin%"
        },
        "vueGreenMarkdown.verticalMargin": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 320,
          "scope": "resource",
          "description": "%config.verticalMargin%"
        },
        "vueGreenMarkdown.horizontalMarginMode": {
          "type": "string",
          "default": "theme",
          "scope": "resource",
          "enum": ["theme", "custom"],
          "enumItemLabels": ["%config.mode.theme%", "%config.mode.custom%"],
          "description": "%config.horizontalMarginMode%"
        },
        "vueGreenMarkdown.verticalMarginMode": {
          "type": "string",
          "default": "theme",
          "scope": "resource",
          "enum": ["theme", "custom"],
          "enumItemLabels": ["%config.mode.theme%", "%config.mode.custom%"],
          "description": "%config.verticalMarginMode%"
        },
        "vueGreenMarkdown.theme": {
          "type": "string",
          "default": "vue",
          "scope": "resource",
          "enum": [
            "vue",
            "paper",
            "bamboo",
            "clean",
            "parchment",
            "night"
          ],
          "enumItemLabels": [
            "%theme.vue%",
            "%theme.paper%",
            "%theme.bamboo%",
            "%theme.clean%",
            "%theme.parchment%",
            "%theme.night%"
          ],
          "enumDescriptions": [
            "%theme.vue.description%",
            "%theme.paper.description%",
            "%theme.bamboo.description%",
            "%theme.clean.description%",
            "%theme.parchment.description%",
            "%theme.night.description%"
          ],
          "description": "%config.theme%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vueGreenMarkdown",
          "title": "%activity.title%",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "vueGreenMarkdown": [
        {
          "type": "webview",
          "id": "vueGreenMarkdown.settings",
          "name": "%view.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "vueGreenMarkdown.openSettings",
        "title": "%command.openSettings%",
        "category": "%command.category%"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:layout": "node --test test/layout/browser.js",
    "test:integration": "node scripts/test-vscode.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "@vscode/test-electron": "^2.5.2",
    "markdown-it": "^14.1.0",
    "playwright-core": "^1.56.0",
    "pngjs": "^7.0.0"
  }
}
