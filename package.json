{
  "name": "vue-theme-markdown",
  "displayName": "阅境 Markdown",
  "description": "Novel reading themes and a Vue-inspired document theme for Markdown previews, with sidebar controls. 小说主题、字号与表格行高设置。",
  "version": "0.3.0",
  "publisher": "zenoschen",
  "author": "zenoschen",
  "icon": "images/icon.png",
  "license": "MIT",
  "homepage": "https://github.com/zenoskongfu/vue-theme-markdown#readme",
  "bugs": {
    "url": "https://github.com/zenoskongfu/vue-theme-markdown/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zenoskongfu/vue-theme-markdown.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "markdown",
    "preview",
    "theme",
    "novel",
    "reading",
    "小说",
    "vue"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "galleryBanner": {
    "color": "#20382c",
    "theme": "dark"
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./v-green.css"
    ],
    "configuration": {
      "title": "阅境 Markdown",
      "properties": {
        "vueGreenMarkdown.fontSize": {
          "type": "integer",
          "default": 14,
          "minimum": 10,
          "maximum": 32,
          "scope": "resource",
          "description": "Markdown preview font size in pixels. Headings and code scale with this size."
        },
        "vueGreenMarkdown.tableRowHeight": {
          "type": "integer",
          "default": 36,
          "minimum": 24,
          "maximum": 120,
          "scope": "resource",
          "description": "Minimum table row height in pixels. Cells stay on one line and wide tables scroll horizontally. Explicit line breaks and taller content can increase the height."
        },
        "vueGreenMarkdown.theme": {
          "type": "string",
          "default": "vue",
          "scope": "resource",
          "enum": [
            "vue",
            "paper",
            "bamboo",
            "clean",
            "parchment",
            "night"
          ],
          "enumItemLabels": [
            "Vue 文档",
            "暖纸",
            "青竹",
            "雾白",
            "古卷",
            "墨夜"
          ],
          "enumDescriptions": [
            "Vue documentation theme; follows the editor appearance.",
            "Warm paper with Songti typography.",
            "Jinjiang-inspired pale green reading page.",
            "Fanqie-inspired clean gray reading page.",
            "Parchment with classical Kaiti typography.",
            "Fixed dark palette for night reading."
          ],
          "description": "Markdown reading theme. Novel themes use their own palettes independently of the editor appearance; explicit high-contrast editor themes retain accessible editor colors."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vueGreenMarkdown",
          "title": "阅境 Markdown",
          "icon": "images/sidebar.svg"
        }
      ]
    },
    "views": {
      "vueGreenMarkdown": [
        {
          "type": "webview",
          "id": "vueGreenMarkdown.settings",
          "name": "阅读设置"
        }
      ]
    },
    "commands": [
      {
        "command": "vueGreenMarkdown.openSettings",
        "title": "打开阅读设置",
        "category": "阅境 Markdown"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:layout": "node --test test/layout/browser.js",
    "test:integration": "node scripts/test-vscode.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "@vscode/test-electron": "^2.5.2",
    "markdown-it": "^14.1.0",
    "playwright-core": "^1.56.0",
    "pngjs": "^7.0.0"
  }
}
